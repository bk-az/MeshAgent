#
# Copy and run this in the OpenSSL directory for ARM compatible OpenSSL stack
#
cd ../openssl
make clean
./Configure linux-armv4 no-weak-ssl-ciphers no-srp no-psk no-comp no-zlib no-zlib-dynamic no-err no-shared no-asm no-rc5 no-idea no-md4 no-rmd160 no-ssl3 no-seed no-camellia no-dso no-bf no-cast no-md2 no-mdc2 no-module no-tests no-apps no-docs --api=1.1.0
make depend
sed 's/ -O3 / -Os /g' Makefile > t
rm Makefile
mv t Makefile
make
cp *.a ../openssl-static/armhf2
cd ..
