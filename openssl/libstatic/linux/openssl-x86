#
# Copy and run this in the OpenSSL directory for Intel x86 64bit compatible OpenSSL stack
#
cd ../openssl
make clean
./Configure linux-x86 no-zlib no-zlib-dynamic no-err no-shared no-asm no-rc5 no-idea no-md4 no-rmd160 no-ssl3 no-seed no-camellia no-dso no-bf no-cast no-md2 no-mdc2 no-module no-tests no-apps no-docs --api=1.1.0
make depend
sed 's/ -O3 / -O3 -m32 /g' Makefile > t
rm Makefile
mv t Makefile
make -j 8
cp *.a ../linux/x86
cd ..
